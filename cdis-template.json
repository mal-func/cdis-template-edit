{
  "schemaVersion": "1.0",
  "name": "cdis-engineering-template",
  "description": "Standard CDIS full-stack engineering template with selectable React/Vue frontends and Express/FastAPI backends",
  "language": [
    "javascript",
    "typescript",
    "python"
  ],
  "components": [
    "front-end",
    "back-end",
    "deployment",
    "docs"
  ],
  "frontends": [
    {
      "id": "react",
      "path": "front-end/react",
      "default": true
    },
    {
      "id": "vue",
      "path": "front-end/vue",
      "default": false
    }
  ],
  "backends": [
    {
      "id": "express",
      "path": "back-end/express",
      "default": true
    },
    {
      "id": "fastapi",
      "path": "back-end/fastapi",
      "default": false
    }
  ],
  "files": {
    "exclude": [
      ".git",
      "node_modules",
      "coverage",
      ".env",
      ".env.local",
      ".venv",
      "__pycache__"
    ]
  }
}